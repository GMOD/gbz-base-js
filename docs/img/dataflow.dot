// Source for docs/img/dataflow.svg, which docs/dataflow.md embeds.
// Regenerate with: dot -Tsvg docs/img/dataflow.dot -o docs/img/dataflow.svg
//
// Deliberately the MAIN PATH only — the node and --between queries, snarl
// extension and the fragment joining are described in dataflow.md instead. A
// diagram that shows every branch stops being the thing you look at first.
// The two identification routes ARE in, because which one a query takes is
// the difference between reading a set of haplotypes and reading the graph.
// Step labels stay to one or two words past the function name for the same
// reason; dataflow.md carries the rest.
//
// Both entry points are drawn at the top. getSubgraphForRange used to be an
// edge label between extractPaths and the GFA box, which put the name of a
// caller at the wrong end of the arrow — it reads as something extractPaths
// calls. It enters where it really enters, and the arrow out of extractPaths
// is labelled with what it hands back.
//
// The storage cluster hangs off nothing on purpose. Every green box reads
// through it, and drawing those six edges buried the spine they cross.
//
// SYNC: ~/src/gmod/bam-js/docs/img/dataflow.dot — same palette, legend and
// spine, and tabix-js, cram-js and hic share them too. The orange "wasm" and
// purple "off the main thread" entries of that legend are absent here rather
// than restyled: nothing in this reader is wasm (docs/why-not-wasm.md is why)
// and it puts nothing on a thread of its own — JBrowse runs the whole thing
// in an RPC worker instead. The blue "entry / result" entry is this diagram's
// own addition: the siblings have one entry point and can leave the mark to
// position, and this one has two.
digraph gbzbasejs {
  rankdir=TB
  bgcolor="white"
  nodesep=0.3
  ranksep=0.36
  node [shape=box style="filled,rounded" fillcolor="#f6f8fa" color="#57606a"
        fontname="Helvetica" fontsize=10 margin="0.14,0.07"]
  edge [color="#57606a" fontname="Helvetica" fontsize=9]

  query    [label="getAlignmentsForRange(path, start, end)" fillcolor="#ddf4ff" color="#0969da"]
  frags    [label="pathFragmentsForRange" fillcolor="#dafbe1" color="#1a7f37"]
  pos      [label="pathPosition\nReferenceIndex" fillcolor="#dafbe1" color="#1a7f37"]
  prefetch [label="prefetch the reference walk" fillcolor="#dafbe1" color="#1a7f37"]
  walk     [label="aroundInterval\nreference walk + context" fillcolor="#fff8c5" color="#9a6700"]
  snarls   [label="extractSnarls"]
  extract  [label="extractPaths\ndecode GBWT records"]
  anchored [label="walkHaplotypesFromAnchor\nHaplotypeAnchors" fillcolor="#dafbe1" color="#1a7f37"]
  sampled  [label="identifyPaths\nHaplotypeSamples" fillcolor="#dafbe1" color="#1a7f37"]
  align    [label="alignments()"]
  out      [label="HaplotypeAlignment[]" fillcolor="#ddf4ff" color="#0969da"]
  sub      [label="getSubgraphForRange(path, start, end)" fillcolor="#ddf4ff" color="#0969da"]
  gfa      [label="Subgraph.toGFA / toSubgraphJson" fillcolor="#ddf4ff" color="#0969da"]

  query -> frags
  sub -> frags [style=dashed label=" first fragment only "]
  frags -> pos [label=" per fragment "]
  pos -> prefetch
  prefetch -> walk
  walk -> snarls [style=dashed label=" snarls "]
  walk -> extract
  snarls -> extract
  extract -> anchored [style=dashed label=" keep + anchors " weight=6]
  extract -> sampled [style=dashed label=" otherwise " weight=6]
  anchored -> align
  sampled -> align
  anchored -> sampled [style=dashed label=" walk cut short "]
  align -> out [weight=10]
  extract -> gfa [style=dashed label=" Subgraph " weight=0]

  subgraph cluster_store {
    label="every green box reads through here, per database"
    labelloc="t"
    fontname="Helvetica"
    fontsize=10
    fontcolor="#57606a"
    color="#d0d7de"
    style="rounded"
    margin=10
    btree [label="b-tree: byRowid / indexSeekLE / scan"]
    pager [label="pager: 64 KiB blocks, cached" fillcolor="#fff8c5" color="#9a6700"]
    source [label="ByteSource.read(length, position)" fillcolor="#dafbe1" color="#1a7f37"]
    btree -> pager -> source
  }

  out -> btree [style=invis weight=10]

  subgraph cluster_legend {
    label="Legend"
    labelloc="t"
    fontname="Helvetica"
    fontsize=10
    fontcolor="#57606a"
    color="#d0d7de"
    style="rounded"
    margin=10
    node [shape=box style="filled,rounded" fontsize=9 margin="0.1,0.04"]
    l1 [label="reads bytes" fillcolor="#dafbe1" color="#1a7f37"]
    l2 [label="cached / shared" fillcolor="#fff8c5" color="#9a6700"]
    l3 [label="dashed: optional" fillcolor="#f6f8fa" color="#57606a"]
    l4 [label="entry / result" fillcolor="#ddf4ff" color="#0969da"]
    l1 -> l2 -> l3 -> l4 [style=invis constraint=true]
  }
}
